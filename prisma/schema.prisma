generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model business {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  description            String?
  timezone               String           @default("America/Argentina/Buenos_Aires")
  is_active              Boolean          @default(true)
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  openai_api_key         String?
  openai_model           String?          @default("gpt-3.5-turbo")
  openai_active          Boolean?         @default(true)
  whatsapp_phone_number  String?
  whatsapp_phone_id      String?
  whatsapp_access_token  String?
  ai_monthly_tokens_used Int              @default(0)
  ai_monthly_token_limit Int              @default(100000)
  ai_plan                String           @default("basic")
  ai_reset_at            DateTime         @default(now()) @db.Timestamptz(6)
  ai_blocked             Boolean          @default(false)
  currency_code          String?          @db.Char(3)
  currency               currency?        @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  business_hours         business_hours[]
  conversation           conversation[]
  customer               customer[]
  draft_order            draft_order[]
  menu_category          menu_category[]
  menu_item              menu_item[]
  orders                 orders[]
}

model conversation {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id             String                 @db.Uuid
  customer_id             String                 @unique(map: "conversation_open_customer_unique", where: raw("(status = 'open'::text)")) @db.Uuid
  channel                 String                 @default("whatsapp")
  status                  String                 @default("open")
  started_at              DateTime               @default(now()) @db.Timestamptz(6)
  last_message_at         DateTime               @default(now()) @db.Timestamptz(6)
  lastReferencedProductId String?                @map("last_referenced_product_id") @db.Uuid
  business                business               @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer                customer               @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation_message    conversation_message[]
  conversation_state      conversation_state?
  orders                  orders[]
}

model conversation_message {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id       String       @db.Uuid
  sender                String
  message               String
  is_ai_generated       Boolean      @default(false)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  externalMessageId     String?      @unique
  ai_prompt_tokens      Int?
  ai_completion_tokens  Int?
  ai_total_tokens       Int?
  ai_estimated_cost_usd Decimal?     @db.Decimal(10, 6)
  whatsapp_message_id   String?      @unique
  conversation          conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model conversation_state {
  conversation_id  String       @id @db.Uuid
  current_intent   String?
  is_human_handled Boolean      @default(false)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)
  metadata         Json?
  pending_action   String?
  conversation     conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model currency {
  code            String            @id @db.Char(3)
  name            String
  symbol          String
  is_active       Boolean           @default(true)
  business        business[]
  customer        customer[]
  menu_item_price menu_item_price[]
  orders          orders[]
}

model customer {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id        String        @db.Uuid
  phone_number       String
  name               String?
  preferred_currency String?       @db.Char(3)
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  conversation       conversation?
  business           business      @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currency           currency?     @relation(fields: [preferred_currency], references: [code], onDelete: NoAction, onUpdate: NoAction)
  orders             orders[]

  @@unique([business_id, phone_number])
}

model draft_order {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String?            @db.Uuid
  customer_phone   String
  status           String             @default("active")
  total_amount     Decimal            @default(0) @db.Decimal(10, 2)
  currency         String             @default("ARS")
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  business         business?          @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  draft_order_item draft_order_item[]
}

model draft_order_item {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_order_id String?      @db.Uuid
  product_id     String?      @db.Uuid
  quantity       Int
  unit_price     Decimal      @db.Decimal(10, 2)
  total_price    Decimal      @db.Decimal(10, 2)
  draft_order    draft_order? @relation(fields: [draft_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menu_item      menu_item?   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model menu_category {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String      @db.Uuid
  name        String
  description String?
  position    Int         @default(0)
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  business    business    @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_item   menu_item[]
}

model menu_item {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id       String             @db.Uuid
  category_id       String             @db.Uuid
  name              String
  description       String?
  ingredients       String?
  preparation       String?
  is_available      Boolean            @default(true)
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  serves_people     Int?
  is_featured       Boolean            @default(false)
  ingredients_notes String?
  image             String?
  draft_order_item  draft_order_item[]
  business          business           @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_category     menu_category      @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  menu_item_price   menu_item_price[]
  order_item        order_item[]
}

model business_hours {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String   @db.Uuid
  day_of_week Int
  opens_at    String
  closes_at   String
  is_closed   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  business    business @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_id, day_of_week])
}

model menu_item_price {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menu_item_id  String    @db.Uuid
  currency_code String    @db.Char(3)
  amount        Decimal   @db.Decimal(12, 2)
  valid_from    DateTime  @default(now()) @db.Timestamptz(6)
  valid_to      DateTime? @db.Timestamptz(6)
  is_active     Boolean   @default(true)
  currency      currency  @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  menu_item     menu_item @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model order_item {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id      String    @db.Uuid
  menu_item_id  String    @db.Uuid
  quantity      Int       @default(1)
  unit_price    Decimal   @db.Decimal(12, 2)
  serves_people Int?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  menu_item     menu_item @relation(fields: [menu_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders        orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model orders {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id     String        @db.Uuid
  customer_id     String        @db.Uuid
  conversation_id String?       @db.Uuid
  status          String        @default("draft")
  currency_code   String        @db.Char(3)
  total_amount    Decimal?      @db.Decimal(12, 2)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  order_item      order_item[]
  business        business      @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation    conversation? @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency        currency      @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  customer        customer      @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
